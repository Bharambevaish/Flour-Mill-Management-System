# ---- MongoDB ----
# Local: mongodb://127.0.0.1:27017/flour_mill_mgmt
MONGODB_URI=mongodb://127.0.0.1:27017/flour_mill_mgmt

# ---- Owner (super admin) bootstrap ----
OWNER_NAME=Mill Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-strong-password

# ---- Session / cookie hardening ----
# Base-64 secret used to hash CSRF-protected cookies; any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# Session lifetime (owner + customer), seconds. 14 days default.
SESSION_TTL=1209600

# ---- App URL (used for absolute links / future emails, push, etc.) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Future: notifications (phase 2) ----
# MSG91_SMS_AUTH_KEY=
# MSG91_SENDER_ID=
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=