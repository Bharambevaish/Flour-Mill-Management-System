# ---- MongoDB ----
# Local: mongodb://127.0.0.1:27017/flour_mill_mgmt
MONGODB_URI=mongodb://127.0.0.1:27017/flour_mill_mgmt

# ---- Owner (super admin) bootstrap ----
OWNER_NAME=Mill Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-strong-password

# ---- Session / cookie hardening ----
# Base-64 secret used to hash CSRF-protected cookies; any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# Session lifetime (owner + customer), seconds. 14 days default.
SESSION_TTL=1209600
# Idle timeout, seconds: a session dies after this much inactivity. 0 disables.
# Default 1800 (30 min).
SESSION_IDLE_TTL=1800
# Set to "true" ONLY when the app sits behind a reverse proxy that sets
# x-forwarded-for (nginx, etc.). When "false" (default) the real socket IP is
# used for rate-limiting/audit so buckets can't be spoofed by spoofing the header.
TRUST_PROXY=false

# ---- TLS cookie flag ----
# Default: Secure is set only in production over HTTPS. Force it on/off here
# only if your deployment chains differ (see src/lib/cookies.ts).
# AUTH_COOKIE_SECURE=true|false

# ---- App URL (used for absolute links / future emails, push, etc.) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Future: notifications (phase 2) ----
# MSG91_SMS_AUTH_KEY=
# MSG91_SENDER_ID=
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# ---- Dev server access from other devices ----
# `npm run dev` already accepts this machine's LAN IPs, private LAN ranges and
# *.local names (see next.config.ts). Add any other hostname you open the dev
# server from (e.g. a tunnel domain), comma-separated, without scheme or port.
# DEV_ALLOWED_ORIGINS=my-tunnel.example.com
